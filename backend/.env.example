# Pravaah backend environment variables
# Copy to .env locally. On Render, set these in the dashboard.

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use for vision + text + chat
GEMINI_MODEL=gemini-2.0-flash

# Comma separated list of allowed origins. Set to the Vercel URL in prod.
# Example: https://pravaah.vercel.app,https://pravaah-git-main.vercel.app
CORS_ORIGINS=*

# Keep the Render free dyno awake. Set this to the public URL of the backend
# itself, for example https://pravaah-api.onrender.com/api/health
# Leave empty to disable.
SELF_PING_URL=

# Self ping interval in seconds (default 12)
SELF_PING_INTERVAL=12
