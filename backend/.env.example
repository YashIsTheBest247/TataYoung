# Pravaah backend environment variables
# Copy to .env locally. On Render, set these in the dashboard.

# ---------------- Gemini ----------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------- Supabase ----------------
# Create a free project at https://supabase.com and run supabase_schema.sql
# in the SQL Editor. Then paste the Project URL and the SERVICE_ROLE key
# (Settings > API). The service role key bypasses RLS and should ONLY live
# on the backend, never in the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# ---------------- CORS ----------------
# Comma separated allowed origins. Set to your Vercel URL in prod.
CORS_ORIGINS=*

# ---------------- Self ping (keep Render free dyno awake) ----------------
# Your own backend URL + /api/health. Leave empty to disable.
SELF_PING_URL=
SELF_PING_INTERVAL=12
